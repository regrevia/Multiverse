{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "artifact_refs"],
  "properties": {
    "text": {"type": "string", "minLength": 1, "maxLength": 100000},
    "artifact_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
