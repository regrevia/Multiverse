{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual delivery result",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_refs", "change_summary"],
  "properties": {
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1}
    },
    "change_summary": {"type": "string", "minLength": 1, "maxLength": 8000}
  }
}
