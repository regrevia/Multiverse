{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multiverse WorkflowPackage v0.1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "multiverse/v0.1"},
    "kind": {"const": "WorkflowPackage"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["workflows", "entrypoints", "requiredFeatures"],
      "properties": {
        "workflows": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "entrypoints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requiredFeatures": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assets": {"type": "object"},
        "evalSuites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "extensions": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
