{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "executors"
  ],
  "properties": {
    "catalogVersion": {
      "const": "multiverse.executor-catalog/v0.1"
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "executorRef",
          "adapter",
          "contractVersion",
          "executorVersion",
          "capabilities",
          "observabilityLevel",
          "permissionLevel",
          "configSchemaRef",
          "configSchemaDigest",
          "supportsCancel",
          "supportsIdempotency",
          "supportsRecoveryQuery",
          "installed",
          "available",
          "verified"
        ],
        "properties": {
          "executorRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "adapter": {
            "enum": [
              "builtin",
              "local_process",
              "http_job",
              "human"
            ]
          },
          "contractVersion": {
            "const": "multiverse/v0.1"
          },
          "executorVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*@[1-9][0-9]*(?![\\s\\S])"
            }
          },
          "observabilityLevel": {
            "enum": [
              "structured",
              "external"
            ]
          },
          "permissionLevel": {
            "enum": [
              "enforced",
              "trusted_local",
              "advisory"
            ]
          },
          "configSchemaRef": {
            "type": "string",
            "minLength": 1
          },
          "configSchemaDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          },
          "supportsCancel": {
            "type": "boolean"
          },
          "supportsIdempotency": {
            "type": "boolean"
          },
          "supportsRecoveryQuery": {
            "type": "boolean"
          },
          "installed": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "verificationEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reference",
              "environment",
              "executorVersion",
              "cases"
            ],
            "properties": {
              "kind": {
                "const": "operator-attestation"
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "string",
                "minLength": 1
              },
              "executorVersion": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
