{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multiverse Predicate v0.1",
  "oneOf": [
    {
      "type": "object",
      "required": ["op", "left", "right"],
      "properties": {
        "op": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in"]},
        "left": {"$ref": "value-expr.schema.json"},
        "right": {"$ref": "value-expr.schema.json"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["all"],
      "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#"}}},
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["any"],
      "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#"}}},
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["not"],
      "properties": {"not": {"$ref": "#"}},
      "additionalProperties": false
    }
  ]
}
