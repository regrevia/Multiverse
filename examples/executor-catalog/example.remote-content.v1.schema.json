{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s/?#]+(?:/[^\\s?#]*)?$"
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "baseUrl"
  ],
  "additionalProperties": false
}
